# Loaded by the systemd user units (copied to ~/.hermes-spark-voice/env by install.sh).
LFM3_AUDIO_PORT=8181
LFM3_AUDIO_CTX=8192
LFM3_AUDIO_PARALLEL=2
LFM3_AUDIO_EXTRA=
LFM3_OMNI_PORT=8182
LFM3_OMNI_CTX=8192
LFM3_OMNI_EXTRA=
LFM3_BRAIN_PORT=8183
LFM3_BRAIN_CTX=32768
LFM3_BRAIN_PARALLEL=2
LFM3_BRAIN_EXTRA=
# spark-calld
SPARK_CALLD_CONFIG=%h/.hermes-spark-voice/calld.yaml
