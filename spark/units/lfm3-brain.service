[Unit]
Description=LFM3-1.7B llama-server (agent brain, tool calling) for Hermes
After=network.target

[Service]
EnvironmentFile=-%h/.hermes-spark-voice/env
ExecStart=%h/.hermes-spark-voice/bin/llama-server \
  -m %h/.hermes-spark-voice/models/brain.gguf \
  --host 127.0.0.1 --port ${LFM3_BRAIN_PORT} \
  --ctx-size ${LFM3_BRAIN_CTX} --parallel ${LFM3_BRAIN_PARALLEL} \
  -ngl 999 --jinja --flash-attn on --temp 0.1 --top-k 50 --repeat-penalty 1.1 \
  --alias LFM3-1.7B
Restart=on-failure
RestartSec=3
Nice=5

# Optional extra flags: add them with a drop-in ->  systemctl --user edit lfm3-brain.service
#   [Service]
#   ExecStart=
#   ExecStart=...your full command line plus the extra flags...

[Install]
WantedBy=default.target
